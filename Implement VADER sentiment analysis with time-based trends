        "# Step 1: Load the Sentiment140 Dataset\n",
        "from datasets import load_dataset\n",
        "import pandas as pd\n",
        "from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Load Sentiment140 dataset (subset for faster testing)\n",
        "#dataset = load_dataset(\"sentiment140\", split=\"train[:500]\")\n",
        "dataset = load_dataset(\"sentiment140\", split=\"train\")\n",
        "\n",
        "df = pd.DataFrame(dataset)\n",
        "\n",
        "# Step 2: Convert the 'date' column to datetime format\n",
        "df['date'] = pd.to_datetime(df['date'].str.replace(r'PDT|PST', '', regex=True).str.strip(), errors='coerce')\n",
        "\n",
        "# Extract additional time information\n",
        "df['day'] = df['date'].dt.day  # Extract day\n",
        "df['year'] = df['date'].dt.year  # Extract year\n",
        "\n",
        "# Step 3: Assign Sentiment Using VADER\n",
        "analyzer = SentimentIntensityAnalyzer()\n",
        "\n",
        "def analyze_sentiment_vader(text):\n",
        "    score = analyzer.polarity_scores(text)['compound']\n",
        "    if score > 0.05:\n",
        "        return \"positive\"\n",
        "    elif score < -0.05:\n",
        "        return \"negative\"\n",
        "    else:\n",
        "        return \"neutral\"\n",
        "\n",
        "df['vader_sentiment'] = df['text'].apply(analyze_sentiment_vader)\n",
        "\n",
        "# Display some sample results for verification\n",
        "print(\"\\nSample Data with VADER Sentiment:\")\n",
        "print(df[['text', 'vader_sentiment']].head(10))\n",
        "\n",
        "# Step 4: Group sentiment by day\n",
        "sentiment_trends = (\n",
        "    df.groupby('day')['vader_sentiment']\n",
        "    .value_counts(normalize=True)\n",
        "    .unstack()\n",
        "    .fillna(0) * 100\n",
        ")\n",
        "\n",
        "# Step 5: Plot Sentiment Trends by Day\n",
        "plt.figure(figsize=(10, 6))\n",
        "sentiment_trends.plot(kind='line', ax=plt.gca(), title=\"Sentiment Trends Over Days (VADER)\")\n",
        "plt.xlabel(\"Day\")\n",
        "plt.ylabel(\"Percentage\")\n",
        "plt.legend(title=\"Sentiment\")\n",
        "plt.grid()\n",
        "plt.show()\n"
      ],
